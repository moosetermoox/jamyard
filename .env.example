ANTHROPIC_API_KEY=your-api-key-here

# Site analytics (optional). PostHog project token; absent = analytics off.
# The browser never talks to PostHog: teacher pages post to /api/track and the
# server relays (services/analytics.js). Student and projector screens send nothing.
POSTHOG_KEY=
# PostHog ingest host (us.i.posthog.com default; eu.i.posthog.com for the EU cloud)
POSTHOG_HOST=https://us.i.posthog.com
