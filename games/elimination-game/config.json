{
  "name": "Last One Standing",
  "description": "Answer questions, vote on favorites, and try to survive three rounds!",
  "minPlayers": 4,
  "maxPlayers": 36,
  "phases": {
    "lobby": {
      "type": "lobby",
      "next": "round-intro"
    },
    "round-intro": {
      "type": "announce",
      "message": "Round {{_loop.eliminate.iteration}} of {{_loop.eliminate.total}} — answer the question and survive the vote!",
      "timer": 6,
      "next": "answer"
    },
    "answer": {
      "type": "collect",
      "prompt": "What is the purpose of chicken?",
      "from": "remaining",
      "timer": 45,
      "next": "show-answers"
    },
    "show-answers": {
      "type": "reveal",
      "template": "# Here's what everyone said:\n\n{{answer.responses.list}}",
      "next": "voting"
    },
    "voting": {
      "type": "vote",
      "mode": "pick-one",
      "candidates": "answer.responses",
      "voters": "remaining",
      "question": "Pick your favorite!",
      "timer": 45,
      "next": "eliminate"
    },
    "eliminate": {
      "type": "eliminate",
      "method": "bottom-percent",
      "percent": 35,
      "input": "voting.scores",
      "pause": 4,
      "loopBack": "round-intro",
      "loopCount": 3,
      "next": "winner"
    },
    "winner": {
      "type": "winner",
      "from": "voting.scores",
      "next": "end"
    },
    "end": {
      "type": "end",
      "message": "Great game, everyone!"
    }
  }
}
