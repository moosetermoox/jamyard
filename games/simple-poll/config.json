{
  "name": "Quick Poll",
  "description": "Ask the class a multiple-choice question and see results as a bar chart",
  "minPlayers": 2,
  "maxPlayers": 36,
  "phases": {
    "lobby": {
      "type": "lobby",
      "next": "poll"
    },
    "poll": {
      "type": "collect-choice",
      "prompt": "Are you more like a duck, or more like an LLM?",
      "choices": [
        "More like a duck",
        "More like an LLM"
      ],
      "timer": 30,
      "next": "results"
    },
    "results": {
      "type": "reveal",
      "template": "Results:\n\n{{poll.barChart}}",
      "next": "end"
    },
    "end": {
      "type": "end",
      "message": "Thanks for sharing!"
    }
  }
}