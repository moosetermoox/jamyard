{
  "name": "Loop Test",
  "description": "A 3-round game to test the loop system",
  "minPlayers": 1,
  "maxPlayers": 36,
  "phases": {
    "lobby": {
      "type": "lobby",
      "next": "round-announce"
    },
    "round-announce": {
      "type": "announce",
      "message": "Round {{_loop.round-results.iteration}} of {{_loop.round-results.total}} — get ready!",
      "timer": 3,
      "next": "round-collect"
    },
    "round-collect": {
      "type": "collect",
      "prompt": "Say something creative! (This is round {{_loop.round-results.iteration}})",
      "timer": 30,
      "next": "round-process"
    },
    "round-process": {
      "type": "ai-process",
      "task": "summarize",
      "instruction": "Summarize these player responses in one fun sentence.",
      "input": "round-collect.responses",
      "format": "text",
      "next": "round-results"
    },
    "round-results": {
      "type": "reveal",
      "template": "Round {{_loop.round-results.iteration}} of {{_loop.round-results.total}} results:\n\n{{round-process.result}}",
      "next": "end",
      "loopBack": "round-announce",
      "loopCount": 3
    },
    "end": {
      "type": "end",
      "message": "All 3 rounds complete! Thanks for playing!"
    }
  }
}