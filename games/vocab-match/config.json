{
  "name": "Vocab Match",
  "description": "Two quick match-the-pairs rounds with a leaderboard. Swap in your own pairs for any review.",
  "when": "When there are pairs to drill, words and meanings or dates and events, and you want it quick and scored.",
  "featured": true,
  "phases": {
    "lobby": {
      "type": "lobby",
      "next": "intro"
    },
    "intro": {
      "type": "announce",
      "message": "VOCAB MATCH!\n\nTwo rounds. Drag the right column on your device so every row is a correct pair. Every correct match earns points, fastest fingers don't matter, correct ones do.",
      "timer": 10,
      "next": "round1"
    },
    "round1": {
      "type": "match",
      "prompt": "Match each term to its meaning",
      "pairs": [
        {
          "left": "simile",
          "right": "compares with like or as"
        },
        {
          "left": "metaphor",
          "right": "says one thing is another"
        },
        {
          "left": "hyperbole",
          "right": "exaggerates on purpose"
        },
        {
          "left": "alliteration",
          "right": "repeats a first sound"
        },
        {
          "left": "personification",
          "right": "gives a thing human traits"
        },
        {
          "left": "onomatopoeia",
          "right": "sounds like its noise"
        }
      ],
      "pointsPerMatch": 10,
      "timer": 60,
      "next": "round2"
    },
    "round2": {
      "type": "match",
      "prompt": "Round 2, match each term to its meaning",
      "pairs": [
        {
          "left": "irony",
          "right": "the opposite of what you expect"
        },
        {
          "left": "theme",
          "right": "the big idea a story is about"
        },
        {
          "left": "setting",
          "right": "where and when it happens"
        },
        {
          "left": "protagonist",
          "right": "the main character"
        },
        {
          "left": "foreshadowing",
          "right": "a hint of what is coming"
        },
        {
          "left": "imagery",
          "right": "words that paint a picture"
        }
      ],
      "pointsPerMatch": 10,
      "timer": 60,
      "next": "scoreboard"
    },
    "scoreboard": {
      "type": "leaderboard",
      "from": [
        "round1.scores",
        "round2.scores"
      ],
      "style": "full",
      "next": "end"
    },
    "end": {
      "type": "end",
      "message": "That's Vocab Match! Twelve terms, nailed down."
    }
  },
  "tags": [
    "review"
  ],
  "playTime": "~10 min",
  "classSize": "2–35 players",
  "keywords": [
    "vocabulary",
    "definitions",
    "language",
    "terms",
    "any subject",
    "matching",
    "literary terms",
    "ela",
    "figurative language"
  ]
}
